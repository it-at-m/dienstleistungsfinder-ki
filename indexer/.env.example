ETRACKER_TOKEN=

# Optional Hugging Face dataset export. Requires write access to both existing
# it-at-m/munich-city-services and it-at-m/munich-city-info dataset repositories.
HF_DATASET_EXPORT_ENABLED=false
HF_TOKEN=
