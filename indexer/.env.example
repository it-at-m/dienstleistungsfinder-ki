# Required indexing configuration
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
OPENAI_API_KEY=
OPENAI_API_BASE=
OPENAI_EMBEDDING_MODEL=

# Collection and authenticated API-ID access
VDB_COLLECTIONS=service,info
API_IDS_URL=https://stadt.muenchen.de/service/rs/befi/services/list
