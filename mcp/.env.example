DLF_RETRIEVAL_URL=http://localhost:8080/api/retrieval
DLF_TIMEOUT=60
MCP_TRANSPORT=streamable-http
MCP_HOST=0.0.0.0
MCP_PORT=8081
MCP_LOG_LEVEL=INFO

# Server-controlled search options (the agent only supplies query).
MCP_ENHANCE_QUERY=true
MCP_RERANK=false
# Omit MCP_N_RESULTS to use the backend default.
# MCP_N_RESULTS=5
# Omit MCP_COLLECTIONS to search all collections; otherwise use a JSON list.
# MCP_COLLECTIONS=["service","info"]

# Optional HTTP Host-header allowlist (JSON). Include client-facing names/ports.
# MCP_ALLOWED_HOSTS=["localhost:*","127.0.0.1:*","host.docker.internal:*","host.containers.internal:*"]
# Only needed for clients that send an Origin header (scheme + host + port).
# MCP_ALLOWED_ORIGINS=["http://host.docker.internal:8321"]
