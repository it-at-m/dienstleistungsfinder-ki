# Local core configuration. Copy to `.env` and fill only values you use.
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
OPENAI_API_KEY=
OPENAI_API_BASE=

# Exact HTTP method/path allowlist for MCP tools; [] exposes no tools.
# Only operations present in the backend OpenAPI schema can be enabled.
MCP_ENDPOINTS='[{"method":"POST","path":"/api/retrieval"}]'
